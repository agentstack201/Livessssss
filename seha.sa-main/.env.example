# Frontend environment variables (Vite)
# Copy this file to .env and fill in the values for your deployment.

# Base URL of the backend API server (no trailing slash)
VITE_API_BASE_URL=http://localhost:3000

# API endpoints (relative paths appended to VITE_API_BASE_URL)
VITE_API_LOGIN=/login
VITE_API_SICK_LEAVES=/sick-leaves
