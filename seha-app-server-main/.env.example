# ─────────────────────────────────────────────────────────────
# Database — Neon (Serverless PostgreSQL)
# ─────────────────────────────────────────────────────────────
# EASIEST: paste the full connection string from the Neon dashboard
# (Project → Connect). Prefer the POOLED string (host contains "-pooler").
# Example:
#   postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ── OR ── set the parts individually (used only if DATABASE_URL is empty):
DB_HOST=            # e.g. ep-xxx-pooler.eu-central-1.aws.neon.tech
DB_USER=            # e.g. neondb_owner
DB_PASSWORD=
DB_NAME=neondb
DB_DIALECT=postgres
DB_PORT=5432

# ─────────────────────────────────────────────────────────────
# Media file storage (Supabase Storage) — OPTIONAL, only for uploads.
# Neon has no object storage, so media uploads still use Supabase.
# Leave blank if you don't use the media upload feature.
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server Configuration
Port=3000

# JWT secret — REQUIRED. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Do NOT reuse this across environments and never commit the real value.
JWT_SECRET=
JWT_EXPIRES_IN=3h

# ─────────────────────────────────────────────────────────────
# LLM key pool — encryption for provider API keys stored in the DB.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the pool falls back to JWT_SECRET, but a dedicated key is preferred.
# ─────────────────────────────────────────────────────────────
ENCRYPTION_KEY=

# Optional: provider keys can also be supplied via env (comma/newline separated).
# Normally you add keys in the admin UI (/keys) instead — these are just a fallback.
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────
# WhatsApp document preview (thumbnail) sharpness — OPTIONAL.
#
# WhatsApp ignores any thumbnail stored inside the PDF (/Thumb, XMP, metadata);
# it renders the first page itself with PDFium at ONE PIXEL PER PDF POINT, so
# the preview resolution equals the page box size in points. Shrinking the page
# geometry (content + box + link annotations together, by the same factor)
# lowers only that thumbnail's resolution. The document stays vector, so it is
# still 100% sharp when opened, zoomed or printed, and text/search/QR/links are
# untouched.
#
#   WHATSAPP_PREVIEW_SCALE=0.1   -> A4 becomes 59x84 pt  -> heavily blurred preview (default)
#   WHATSAPP_PREVIEW_SCALE=0.15  -> 89x126 pt            -> blurred, shapes still readable
#   WHATSAPP_PREVIEW_SCALE=0.25  -> 149x210 pt           -> soft
#   WHATSAPP_PREVIEW_SCALE=off   -> feature disabled, original A4 output
WHATSAPP_PREVIEW_SCALE=0.1
# Keep the real A4 print size via /UserUnit (PDF 1.6+). Set to "off" only if a
# viewer that honours /UserUnit also keeps the preview sharp.
WHATSAPP_PREVIEW_USER_UNIT=on

# CORS / URLs — set to your deployed frontend origin
CORS_ORIGIN=https://your-frontend.vercel.app
SERVER_HOST=https://your-api.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app
