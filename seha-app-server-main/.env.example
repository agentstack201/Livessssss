# ═════════════════════════════════════════════════════════════════
# Seha App Server — Environment Variables (Backend)
# انسخ هذا الملف محلياً إلى .env، أو الصق القيم في Render Dashboard →
# اسم الخدمة → Environment. لا تُرفع القيم الحقيقية إلى المستودع أبداً
# (.env مُستثنى عبر .gitignore، هذا الملف قالب فقط).
# ═════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# Database — PostgreSQL (Neon Serverless موصى به)
# ─────────────────────────────────────────────────────────────
# EASIEST: الصق سلسلة الاتصال الكاملة من لوحة Neon (Project → Connect).
# فضّل السلسلة الـ POOLED (تحتوي "-pooler" في اسم المضيف) — مناسبة لبيئة
# serverless/عدد اتصالات كبير. مثال:
#   postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# REQUIRED (ما لم تُعبّئ الأجزاء المنفردة أدناه بدلاً منها).
DATABASE_URL=

# ── أو ── عبّئ الأجزاء منفردة (تُستخدم فقط إذا كانت DATABASE_URL فارغة):
DB_HOST=            # e.g. ep-xxx-pooler.eu-central-1.aws.neon.tech
DB_USER=            # e.g. neondb_owner   (DB_USERNAME مقبول أيضاً كاسم بديل)
DB_PASSWORD=
DB_NAME=neondb
DB_PORT=5432
# لا يوجد متغيّر DB_DIALECT فعلي: الـ dialect مثبّت على postgres داخل
# config/database.js، فأي قيمة هنا بلا أثر.

# لا حاجة لأي أمر "migrate" يدوي بعد النشر: عند إقلاع الخادم يُشغَّل
# sequelize.sync({alter:false}) ثم مزامنة الأعمدة من config/schemaSync.js
# تلقائياً (انظر index.js). مجلد migrations/ يحوي سكربتات صيانة تُشغَّل يدوياً
# عند الحاجة فقط (مثل create-admin أدناه)، وليست جزءاً من مسار الإقلاع العادي.

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
# منفذ الاستماع — لتطوير محلي فقط. على Render لا تضبطه يدوياً إطلاقاً: المنصّة
# تحقن PORT تلقائياً ويقرأه الكود بالأولوية (Port بحرف P كبير مدعوم كبديل
# تراثي فقط).
PORT=3000

# ─────────────────────────────────────────────────────────────
# Auth — JWT
# ─────────────────────────────────────────────────────────────
# REQUIRED. بدونه يفشل تسجيل الدخول فوراً (jwt.sign بمفتاح undefined).
# توليد قيمة قوية:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# لا تُعِد استخدام نفس القيمة بين بيئات مختلفة، ولا ترفع القيمة الحقيقية أبداً.
# على Render: اترك render.yaml يولّدها تلقائياً (generateValue) بدل تعبئتها يدوياً.
JWT_SECRET=
JWT_EXPIRES_IN=3h

# ─────────────────────────────────────────────────────────────
# Media file storage (Supabase Storage) — OPTIONAL
# ─────────────────────────────────────────────────────────────
# بدون ضبطهما، رفع الوسائط (الشعارات وغيرها) يستمر بالعمل: يُخزَّن الملف كـ
# data URI (base64) داخل عمود url في قاعدة البيانات مباشرة — مقبول للصور
# الصغيرة، لكن يُضخّم حجم القاعدة. لتخزين خارجي حقيقي اربط Supabase Storage
# (bucket باسم "media"):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# LLM key pool — تشفير مفاتيح مزوّدي الذكاء الاصطناعي المخزّنة في القاعدة
# ─────────────────────────────────────────────────────────────
# توليد: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# إن تُرك فارغاً يُستخدم JWT_SECRET بدلاً منه (يعمل، لكن مفتاح مستقل أفضل أمنياً
# ومُستحسن دوماً). على Render: اترك render.yaml يولّدها تلقائياً.
ENCRYPTION_KEY=

# مفتاح Gemini احتياطي فقط — الطريقة المعتادة هي إضافة المفاتيح من لوحة
# التحكم (صفحة /keys) حيث تُخزَّن مشفّرة في القاعدة مع تدوير تلقائي بين عدة
# مفاتيح. GOOGLE_API_KEY اسم بديل مقبول لنفس القيمة.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# تجاوز اسم موديل Gemini الافتراضي (نادراً ما يُحتاج إليه):
# GEMINI_MODEL=

# ─────────────────────────────────────────────────────────────
# إرسال التقارير عبر واتساب من الخادم — اختياري، معطّل افتراضياً.
#
# لماذا من الخادم؟ لأن صورة معاينة المستند داخل محادثة واتساب ليست جزءاً من
# الـ PDF إطلاقاً، بل حقل مستقل في الرسالة (DocumentMessage.jpegThumbnail)
# يحدّده العميل الذي يبني الرسالة. عند المشاركة من المتصفح (navigator.share)
# يبنيها واتساب بنفسه فتظهر حادّة ولا سبيل للتدخّل. أما حين يرسل الخادم فيمرّر
# مصغّرة مموّهة من صنعنا مع بايتات الـ PDF كما هي — فتكون المعاينة غائمة
# والملف عند فتحه أصلياً وحادّاً 100%.
#
# ⚠️ يستخدم بروتوكول واتساب-ويب غير الرسمي (Baileys): مخالف لشروط واتساب وقد
# يُحظر الرقم. استخدم رقماً مخصّصاً، وأبقِ الوجهة الافتراضية على رقمنا نحن ثم
# أعِد توجيه الرسالة للزبون يدوياً (إعادة التوجيه تنقل المصغّرة كما هي).
WHATSAPP_SENDER_ENABLED=false
# رقم الاستقبال الافتراضي (رقمنا) — إليه تُرسل التقارير ثم يُعاد توجيهها.
WHATSAPP_SELF_NUMBER=

# مهلات جلسة واتساب (اختيارية — القيم الافتراضية معقولة لأغلب الحالات):
# WHATSAPP_PAIRING_TTL_MS=180000      # صلاحية رمز الإقران (٣ دقائق)
# WHATSAPP_CONNECT_TIMEOUT_MS=25000   # مهلة انتظار اكتمال الاتصال قبل الإرسال
# WHATSAPP_QR_TIMEOUT_MS=120000       # مهلة رمز الـ QR الأول (٦٠ث) وكل تالٍ (٢٠ث)

# ضبط شكل المصغّرة (لا علاقة لها بالـ PDF إطلاقاً). توليفات مجرَّبة، من الأخف
# إلى الأغمض — القيمة الأولى هي العرض، ثم نصف قطر التمويه، ثم الجودة:
#   300 / 1 / 70  → ناعم لكن العناوين تُقرأ
#   200 / 2 / 55  → تُميَّز الشعارات وصفوف الجدول
#   180 / 2 / 50  → الافتراضي: يُعرف أنه تقرير صحة بلا أي نص مقروء
#   160 / 3 / 45  → أغمض
#   120 / 4 / 40  → أقرب شكل للملف المرجعي (بقع + شريط كحلي فقط)
WHATSAPP_THUMB_WIDTH=180      # كلما صغُر العرض زاد الغيام عند التكبير
WHATSAPP_THUMB_BLUR=2         # نصف قطر التمويه بالبكسل
WHATSAPP_THUMB_QUALITY=50     # جودة ضغط JPEG (1–100)
WHATSAPP_THUMB_MAX_BYTES=24576  # سقف أمان لحجم المصغّرة (تُخفَّض الجودة تلقائياً عند تجاوزه)
# للمعاينة قبل الإرسال:
#   GET /sick-leaves/:service_num/:national_id/whatsapp-thumbnail  (يعيد الـ JPEG نفسها)
#   node scripts/whatsapp-thumb-preview.js <ملف.pdf> <الناتج.jpg> [العرض] [التمويه] [الجودة]

# ─────────────────────────────────────────────────────────────
# PDF rendering (Chromium) — يُكتشف تلقائياً، نادراً ما يحتاج تدخّلاً يدوياً
# ─────────────────────────────────────────────────────────────
# الكود يختار تلقائياً Chromium المُجمَّع (@sparticuz/chromium + puppeteer-core،
# بلا تنزيل متصفح) بدل Puppeteer الكامل عندما يكون RENDER أو VERCEL_ENV
# مضبوطاً — Render وVercel يضبطانهما تلقائياً بأنفسهما، لا تلمسهما يدوياً.
# فعّل هذا الخيار فقط إن اختبرت محلياً واحتجت محاكاة سلوك الإنتاج:
# USE_BUNDLED_CHROMIUM=true
# رابط مخصّص لأرشيف Chromium (حالات نادرة/بيئات خاصة فقط):
# CHROMIUM_URL=

# ─────────────────────────────────────────────────────────────
# CORS / URLs
# ─────────────────────────────────────────────────────────────
# عنوان الواجهة الأمامية المنشورة — يُستخدم في: رابط رمز QR للتحقق، رابط
# "الذهاب للموقع" في صفحة الجذر، ورابط الوجهة الافتراضي في رسائل واتساب.
# اضبطه على نطاق الواجهة الفعلي بعد النشر (بلا شرطة مائلة زائدة في النهاية).
FRONTEND_URL=https://your-frontend.vercel.app

# ─────────────────────────────────────────────────────────────
# سكربتات صيانة يدوية (لا علاقة لها بتشغيل الخادم نفسه — تُقرأ فقط عند
# تشغيل السكربت المذكور مباشرة، وليست جزءاً من "npm start")
# ─────────────────────────────────────────────────────────────
# RESET_EXISTING_PASSWORDS=true   # يُقرأ فقط بواسطة: node migrations/create-team-accounts.js

# ─────────────────────────────────────────────────────────────
# ⚠️ متغيّرات موثّقة تاريخياً في هذا المشروع لكنها غير مقروءة من أي كود نشِط
# حالياً — لا ضرر من تركها فارغة، لكن تعديل قيمتها لن يُغيّر أي سلوك فعلي:
#   • CORS_ORIGIN — الـ CORS في index.js مضبوط صراحة على origin:true (يسمح
#     لكل النطاقات) بغضّ النظر عن أي قيمة هنا.
#   • SERVER_HOST — يظهر فقط داخل middlewares/generatePdf11.js و
#     generatePdfExact.js، وكلاهما غير مُستدعى من config/middlewares.js
#     (المولّدات الفعلية المُركَّبة هي generatePdf.js وأخواتها، وتعتمد على
#     FRONTEND_URL بدلاً منه).
# ─────────────────────────────────────────────────────────────
# CORS_ORIGIN=
# SERVER_HOST=
