# ─────────────────────────────────────────────────────────────
# Database — Neon (Serverless PostgreSQL)
# ─────────────────────────────────────────────────────────────
# EASIEST: paste the full connection string from the Neon dashboard
# (Project → Connect). Prefer the POOLED string (host contains "-pooler").
# Example:
#   postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ── OR ── set the parts individually (used only if DATABASE_URL is empty):
DB_HOST=            # e.g. ep-xxx-pooler.eu-central-1.aws.neon.tech
DB_USER=            # e.g. neondb_owner
DB_PASSWORD=
DB_NAME=neondb
DB_DIALECT=postgres
DB_PORT=5432

# ─────────────────────────────────────────────────────────────
# Media file storage (Supabase Storage) — OPTIONAL, only for uploads.
# Neon has no object storage, so media uploads still use Supabase.
# Leave blank if you don't use the media upload feature.
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server Configuration
Port=3000

# JWT secret — REQUIRED. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Do NOT reuse this across environments and never commit the real value.
JWT_SECRET=
JWT_EXPIRES_IN=3h

# ─────────────────────────────────────────────────────────────
# LLM key pool — encryption for provider API keys stored in the DB.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the pool falls back to JWT_SECRET, but a dedicated key is preferred.
# ─────────────────────────────────────────────────────────────
ENCRYPTION_KEY=

# Optional: provider keys can also be supplied via env (comma/newline separated).
# Normally you add keys in the admin UI (/keys) instead — these are just a fallback.
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────
# إرسال التقارير عبر واتساب من الخادم — اختياري، معطّل افتراضياً.
#
# لماذا من الخادم؟ لأن صورة معاينة المستند داخل محادثة واتساب ليست جزءاً من
# الـ PDF إطلاقاً، بل حقل مستقل في الرسالة (DocumentMessage.jpegThumbnail)
# يحدّده العميل الذي يبني الرسالة. عند المشاركة من المتصفح (navigator.share)
# يبنيها واتساب بنفسه فتظهر حادّة ولا سبيل للتدخّل. أما حين يرسل الخادم فيمرّر
# مصغّرة مموّهة من صنعنا مع بايتات الـ PDF كما هي — فتكون المعاينة غائمة
# والملف عند فتحه أصلياً وحادّاً 100%.
#
# ⚠️ يستخدم بروتوكول واتساب-ويب غير الرسمي (Baileys): مخالف لشروط واتساب وقد
# يُحظر الرقم. استخدم رقماً مخصّصاً، وأبقِ الوجهة الافتراضية على رقمنا نحن ثم
# أعِد توجيه الرسالة للزبون يدوياً (إعادة التوجيه تنقل المصغّرة كما هي).
WHATSAPP_SENDER_ENABLED=false
# رقم الاستقبال الافتراضي (رقمنا) — إليه تُرسل التقارير ثم يُعاد توجيهها.
WHATSAPP_SELF_NUMBER=

# ضبط شكل المصغّرة (لا علاقة لها بالـ PDF إطلاقاً). ثلاث توليفات مجرَّبة:
#   خفيف : 300 / 1 / 70  → ناعم لكن يُقرأ
#   متوسط: 200 / 2 / 55
#   ثقيل : 120 / 4 / 40  → أقرب شكل للملف المرجعي (بقع + شريط كحلي فقط)
WHATSAPP_THUMB_WIDTH=120      # كلما صغُر العرض زاد الغيام عند التكبير
WHATSAPP_THUMB_BLUR=4         # نصف قطر التمويه بالبكسل
WHATSAPP_THUMB_QUALITY=40     # جودة ضغط JPEG (1–100)
WHATSAPP_THUMB_MAX_BYTES=24576  # سقف أمان لحجم المصغّرة (تُخفَّض الجودة تلقائياً عند تجاوزه)
# للمعاينة قبل الإرسال:
#   GET /sick-leaves/:service_num/:national_id/whatsapp-thumbnail  (يعيد الـ JPEG نفسها)
#   node scripts/whatsapp-thumb-preview.js <ملف.pdf> <الناتج.jpg> [العرض] [التمويه] [الجودة]

# CORS / URLs — set to your deployed frontend origin
CORS_ORIGIN=https://your-frontend.vercel.app
SERVER_HOST=https://your-api.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app
